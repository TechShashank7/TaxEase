# ── Core & Security ──────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex to match Vercel preview and production deployments automatically
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── AI & Database Services ──────────────────────────────────────────────────
# Google Gemini API Key for explanations and chat assistant
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (MongoDB Atlas or self-hosted)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/tax-easy

# ── Vector Search (Qdrant) ──────────────────────────────────────────────────
# For local Docker: http://localhost:6333
# For Qdrant Cloud: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=income_tax_act

# ── RAG Settings ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
RAG_TOP_K=5
RAG_MIN_SCORE=0.72
RAG_ENABLED=True
